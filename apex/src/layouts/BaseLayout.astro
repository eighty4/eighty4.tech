---
type Props = {
    subtitle?: string
}

const { subtitle } = Astro.props

const sep = ':'
const title = `${subtitle ? `${subtitle} ${sep} ` : ''}eighty4`
---

<html lang="en">
    <head>
        <meta charset="utf-8" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <meta name="viewport" content="width=device-width" />
        <title>{title}</title>
    </head>
    <body>
        <slot />
    </body>
</html>

<style is:global>
    body,
    h1,
    h2,
    h3,
    h4,
    h5,
    h6,
    ol,
    ul {
        margin: 0;
        padding: 0;
    }
    li {
        list-style-type: none;
    }
</style>
