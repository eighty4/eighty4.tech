---
import { type CollectionEntry, render } from 'astro:content'
import BaseLayout from '../../../layouts/BaseLayout.astro'
import { getWriting } from '../../../writing.ts'

type Props = {
    piece: CollectionEntry<'writing'>
}

export async function getStaticPaths() {
    const content = await getWriting()
    return content.map(piece => ({
        params: { slug: piece.id },
        props: { piece },
    }))
}

const { Content } = await render(Astro.props.piece)
---

<BaseLayout>
    <h1>{Astro.props.piece.data.title}</h1>
    <h2>{Astro.props.piece.data.date}</h2>
    <Content />
</BaseLayout>
