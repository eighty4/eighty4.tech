---
import { type CollectionEntry, getEntry } from 'astro:content'

type Props = {
    project: CollectionEntry<'projects'>
}

const { project } = Astro.props
const repo = await getEntry(project.data.repo)
---

<div class="project">
    <h3>
        <a class="title" href={repo.data.url}>
            {project.data.name ?? project.data.id}
        </a>
    </h3>
    <div class="desc">
        {repo.data.description}
    </div>
</div>

<style>
    .title {
        font-size: 1.5rem;
        color: var(--color-sky-dark);
        text-decoration: none;
        &:hover {
            color: var(--color-sky-light);
        }

        &:active {
            color: var(--color-green);
        }
    }

    .desc {
        color: #333;
        font-size: 1.1rem;
        font-weight: 100;
        margin-top: 0.75rem;
    }
</style>
