---
import { getCollection, type CollectionEntry } from 'astro:content'
import ProjectCard from './ProjectCard.astro'

type Props = {
    projects: Array<CollectionEntry<'projects'>>
}
---

<ol class="project-list">
    {
        Astro.props.projects.map(p => (
            <li class="project-list-item">
                <ProjectCard project={p} />
            </li>
        ))
    }
</ol>

<style>
    .project-list {
        list-style: none;
        & .project-list-item {
            --green-scale: 1;
            --pink-scale: 0;
            margin-top: 2.5rem;
            position: relative;
            padding-left: 1rem;
            &::before,
            &::after {
                content: '';
                inset: 0;
                margin-left: var(--content-inset);
                position: absolute;
                width: 3px;
                height: 1.375rem;
                border-radius: 1.5px;
                transform-origin: center;
                transition: transform 150ms linear;
            }
            &::before {
                z-index: 2;
                background: var(--color-green);
                transform: translateX(-1rem) scaleY(var(--green-scale));
            }
            &::after {
                z-index: 3;
                background: var(--color-pink);
                transform: translateX(-1rem) scaleY(var(--pink-scale));
            }

            &:hover {
                --green-scale: 0;
                --pink-scale: 1;
            }
        }
    }
</style>
